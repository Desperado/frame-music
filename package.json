{
  "name": "frame-music",
  "version": "0.1.0",
  "description": "A Samsung Tizen TV music controller for Yamaha MusicCast devices.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Desperado/frame-music.git"
  },
  "bugs": "https://github.com/Desperado/frame-music/issues",
  "homepage": "https://github.com/Desperado/frame-music#readme",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "prestart": "npm run build",
    "start": "node scripts/server.js",
    "test": "npm run test:shared && npm run test:tv",
    "test:shared": "npm test --workspace @mosaicast/musiccast",
    "pretest:tv": "npm run build --workspace @mosaicast/musiccast",
    "test:tv": "node --test test/*.test.js",
    "typecheck": "npm run typecheck --workspace @mosaicast/musiccast",
    "check": "npm run typecheck && npm test && npm run build",
    "bundle:check": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/musiccast"
  ],
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  }
}
