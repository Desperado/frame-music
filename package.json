{
  "name": "frame-music",
  "version": "0.1.0",
  "description": "A Samsung Tizen TV music controller for Yamaha MusicCast devices.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Desperado/frame-music.git"
  },
  "bugs": "https://github.com/Desperado/frame-music/issues",
  "homepage": "https://github.com/Desperado/frame-music#readme",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "prestart": "npm run build",
    "start": "node scripts/server.js",
    "test": "node --test test/*.test.js && npm test --workspace @mosaicast/musiccast",
    "pretest": "npm run build:shared",
    "build:shared": "npm run build --workspace @mosaicast/musiccast",
    "typecheck": "npm run typecheck --workspace @mosaicast/musiccast",
    "check": "npm run typecheck && npm test && npm run build",
    "bundle:check": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "~6.0.3"
  }
}
